---
// Shared top bar. On the monitor the page script fills #pill-text with the live score and sets --band, and the view
// toggle switches between the simple view (the default) and the full monitor.
---

<header class="topbar">
  <a class="brand" href="/" aria-label="Will the system collapse? Home">
    <svg viewBox="0 0 32 20" width="30" height="19" aria-hidden="true"><path d="M3 18a13 13 0 0 1 4.2-9.6" stroke="#6fbf8e"/><path d="M8.6 7.3a13 13 0 0 1 14.8 0" stroke="#d9b45a"/><path d="M24.8 8.4A13 13 0 0 1 29 18" stroke="#e05a47"/><path d="M16 18 20 7" stroke="#f4efe3" stroke-width="2"/></svg>
    <span>willthesystemcollapse<em>.com</em></span>
  </a>
  <nav aria-label="Main">
    {Astro.url.pathname === '/' && <div class="view" role="group" aria-label="View"><button type="button" class="set-view" value="simple">Simple</button><button type="button" class="set-view" value="full">Full</button></div>}
    <a class="hide-s" href="/#method-s">Method</a>
    <a class="hide-s" href="/live/collapse.json">Open data</a>
    <a href="/about/" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
    <a class="pill" href="/#scale-s" id="pill"><i></i><span id="pill-text">live</span></a>
  </nav>
</header>

<style>
  .topbar { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 12px; height: var(--top); padding-inline: var(--gutter); background: rgba(11, 11, 14, 0.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--rule); }
  .brand { display: inline-flex; align-items: center; gap: 10px; min-width: 0; text-decoration: none; font: 600 0.9rem var(--mono); letter-spacing: -0.01em; white-space: nowrap; }
  .brand svg { flex: none; fill: none; stroke-width: 3; }
  .brand span { overflow: hidden; text-overflow: ellipsis; }
  .brand em { font-style: normal; color: var(--muted); }
  nav { display: flex; align-items: center; gap: 2px; font-size: 0.84rem; }
  nav a { padding: 6px 10px; color: var(--muted); text-decoration: none; white-space: nowrap; }
  nav a:hover, nav a[aria-current] { color: var(--ink); }
  .view { display: inline-flex; margin-right: 6px; border: 1px solid var(--rule); }
  .view button { padding: 5px 9px; font: 600 0.72rem var(--body); color: var(--muted); background: none; border: 0; cursor: pointer; }
  .view button:hover { color: var(--ink); }
  :global(:root:not([data-view='full'])) .view [value='simple'], :global(:root[data-view='full']) .view [value='full'] { color: #17140c; background: var(--gold); }
  .pill { display: inline-flex; align-items: center; gap: 8px; margin-left: 6px; color: var(--ink); border: 1px solid color-mix(in srgb, var(--band) 45%, transparent); background: color-mix(in srgb, var(--band) 12%, transparent); font: 600 0.78rem var(--mono); }
  .pill i { width: 7px; height: 7px; background: var(--band); animation: pulse 2s infinite; }
  @media (max-width: 720px) { .hide-s { display: none; } }
  @media (max-width: 600px) { .brand { font-size: 0.78rem; } nav a { padding-inline: 8px; } }
  /* phones: the logo alone, so the view toggle, About and the live pill fit beside it; a long band label gets cut */
  @media (max-width: 440px) {
    .brand span { display: none; }
    nav { min-width: 0; }
    nav a { padding-inline: 6px; }
    .view { margin-right: 4px; }
    .view button { padding-inline: 7px; }
    .pill { min-width: 0; }
    #pill-text { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
  }
</style>
