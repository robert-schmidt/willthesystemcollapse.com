---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

import { ARCHIVE, LICENSE, REPO } from '../site';

// Live data: /live/collapse.json, written every 15 minutes by collector/collect.py on the server (see README.md).
// collect.py also writes the live answer, score and summary into the built page (the ids below) and the dateModified
// fields, so the first paint and crawlers see the reading before the script runs.
const SITE = Astro.site!.href.replace(/\/$/, '');
const ODDS = [
  ['crisis_12m', 'Crisis starting within 12 months', 'any of the 13 episodes since 1973, 6 of them without a recession'],
  ['crisis_24m', 'Crisis starting within 24 months', 'any episode, from SVB-size to 2008-size'],
  ['severe_24m', 'Severe crisis starting within 24 months', '1973–75, 1979–82, 2008 or 2020 scale'],
  ['recession_24m', 'US recession starting within 24 months', 'NBER dates'],
  ['bear_24m', 'US stocks falling 20%+ within 24 months', 'OECD share-price index'],
];
const NOW = new Date().toISOString().slice(0, 19) + 'Z';
const DESCRIPTION = 'A live 0–100 financial stress index, backtested since 1973: crisis odds, recession probability, inflation, debt and gold from 140+ public data feeds, every 15 minutes.';
const ld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': `${SITE}/#website`, url: `${SITE}/`, name: 'Will the system collapse?', description: DESCRIPTION, inLanguage: 'en', publisher: { '@id': `${SITE}/#org` } },
    { '@type': 'Organization', '@id': `${SITE}/#org`, name: 'Will the system collapse?', url: `${SITE}/`, logo: `${SITE}/apple-touch-icon.png`, sameAs: [REPO] },
    { '@type': 'WebPage', '@id': `${SITE}/#webpage`, url: `${SITE}/`, name: 'Will the system collapse? Live financial stress index', inLanguage: 'en', isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': `${SITE}/#dataset` }, dateModified: NOW },
    {
      '@type': 'Dataset', '@id': `${SITE}/#dataset`, url: `${SITE}/`, name: 'Will the system collapse? Live financial stress score',
      description: 'A 0–100 score of US and global financial-system stress, refreshed every 15 minutes from 140+ public series (Federal Reserve, FRED, US Treasury, OFR, ECB, IMF, World Bank, exchanges), with its pillars, red flags, a 12-month recession probability and a monthly backtest since 1973.',
      keywords: ['financial stress index', 'recession probability', 'yield curve', 'systemic risk', 'inflation', 'government debt', 'gold'],
      license: LICENSE, isAccessibleForFree: true, creator: { '@id': `${SITE}/#org` }, temporalCoverage: '1973-01/..', dateModified: NOW,
      distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE}/live/collapse.json` }],
    },
  ],
};
---

<Base
  title="Will the system collapse? Live financial stress index"
  description={DESCRIPTION}
  ld={ld}
>
  <script is:inline slot="head">
    // simple view unless the visitor chose the full one; a link to a section (/#method-s) opens the full monitor
    var v = 'simple';
    try { v = localStorage.getItem('view') || v; } catch (e) {}
    document.documentElement.dataset.view = location.hash.length > 1 ? 'full' : v;
  </script>
  <Header />
  <div class="ticker" aria-hidden="true" data-nosnippet><div class="track" id="ticker"></div></div>

  <main class="page">
    <section class="hero">
      <div class="hero-main">
        <p class="eyebrow"><span class="live-dot"></span> Live monitor · <time id="updated">connecting…</time></p>
        <h1>Will the system collapse?</h1>
        <p class="answer-k">Right now</p>
        <p class="answer" id="answer" data-band="checking" style="--len:9">CHECKING…</p>
        <p class="lede simple-only">A 0–100 gauge of stress in the financial system, built from 140+ public data feeds and backtested on every crisis since 1973.</p>
        <p class="lede" id="summary">Reading over 140 public data feeds from central banks, the US Treasury and markets.</p>
        <div class="flag-strip" id="flag-strip"></div>
        <div class="unusual"><p class="eyebrow">Unusual right now</p><ul id="unusual-list"><li class="none">Checking…</li></ul></div>
      </div>
      <div class="hero-side">
        <div class="card gauge-card">
          <div class="card-head"><h2 id="gauge-title">System stress score</h2><span class="meta">0–100 · backtested since 1973</span></div>
          <svg id="gauge" viewBox="0 0 320 190" role="img" aria-label="Gauge of the system stress score">
            <g id="gauge-bands"></g>
            <g id="gauge-marks"></g>
            <g id="needle" class="needle"><line x1="160" y1="160" x2="160" y2="44"></line><rect x="153" y="153" width="14" height="14"></rect></g>
          </svg>
          <p class="score"><span id="score">--</span><small>/100</small></p>
          <p class="band-label" id="band-label">&nbsp;</p>
        </div>
        <div class="readouts tiles" id="readouts">
          <div class="ro card"><b id="ro-acute">--</b><span>Crisis now</span><em>stress + recession warning</em></div>
          <div class="ro card"><b id="ro-structural">--</b><span>Structural risk</span><em id="ro-record">record</em></div>
          <div class="ro card"><b id="ro-stag">--</b><span>Stagflation index</span><em>inflation &amp; money + warning</em></div>
          <div class="ro card"><b id="ro-rec">--</b><span>Recession, 12 months</span><em>yield-curve model</em></div>
        </div>
      </div>
    </section>

    <section class="odds" aria-labelledby="odds-title">
      <div class="odds-head">
        <h2 id="odds-title">Will it? What followed months like this one</h2>
        <p class="muted small" id="odds-note">Every month since 1973 that wasn't already in the event, weighted by how close its score was to today's, and what happened next, against the average month.</p>
      </div>
      <div class="odds-grid tiles" id="odds-grid">
        {ODDS.map(([k, title, note]) => <div class="card odd avg-risk" data-k={k}><p class="ov">--</p><p class="ot">{title}</p><p class="ob"><span>average month --</span><i></i></p><p class="muted tiny">{note}</p></div>)}
      </div>
    </section>

    <nav class="subnav" aria-label="Sections">
      <a href="#pillars-s">Pillars</a>
      <a href="#flags-s">Red flags</a>
      <a href="#scale-s">When to worry</a>
      <a href="#history-s">50 years</a>
      <a href="#outlook-s">Long run</a>
      <a href="#society-s">Society</a>
      <a href="#households-s">Households</a>
      <a href="#cases-s">Past crises</a>
      <a href="#forecast-s">Recession model</a>
      <a href="#lead-s">Before crises</a>
      <a href="#stag-s">Inflation</a>
      <a href="#markets-s">Gold markets</a>
      <a href="#debt-s">Debt</a>
      <a href="#method-s">Method</a>
      <a href="#feeds-s">Feeds</a>
    </nav>

    <section class="section" id="pillars-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">01</span>The five pillars</p><h2 class="section-title">What the score is made of</h2></div>
        <p class="lede full-only">Each pillar is the average percentile of its inputs against their own history: 90 means worse than 90% of all months on record.</p>
        <p class="lede simple-only">Each compares today with every month on record: 90 means worse than 90% of them.</p></header>
      <div class="pillars" id="pillars"></div>
      <p class="simple-only"><button type="button" class="set-view more" value="full">Full monitor: red flags, crisis odds, 50 years of history, the method →</button></p>
    </section>

    <section class="section" id="flags-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">02</span>Right now</p><h2 class="section-title">Red flags, and what's still holding</h2></div>
        <p class="lede">Every input at the extremes of its own history. A red flag is a reading worse than at least 85% of all months on record.</p></header>
      <div class="grid-2 flags-grid">
        <div class="card flagbox"><div class="card-head"><h3>Red flags <span id="flag-count"></span></h3><span class="meta">percentile</span></div><ul id="flags-high" class="flags"></ul></div>
        <div class="card flagbox"><div class="card-head"><h3>Reassuring</h3><span class="meta">percentile</span></div><ul id="flags-low" class="flags ok"></ul></div>
      </div>
    </section>

    <section class="section" id="scale-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">03</span>Reading the gauge</p><h2 class="section-title">When should you worry?</h2></div>
        <p class="lede">Each band comes from the backtest: how often, since 1973, a reading that high came with a crisis already under way or one that began within the following 12 months.</p></header>
      <div class="card scale-card">
        <div id="scale" class="scale"></div>
        <p class="bands-k">Share of months in each band with a crisis under way or starting within a year, or within two</p>
        <div class="bands tiles" id="bands"></div>
        <p class="muted small" id="band-note"></p>
      </div>
    </section>

    <section class="section" id="history-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">04</span>Backtest · 1973 to today</p><h2 class="section-title">Fifty years of the gauge</h2></div>
        <p class="lede">What the score would have said at the time, month by month. Each point uses only data available then: percentiles against the history so far, and a recession model refitted every January on outcomes already known.</p></header>
      <div class="card chart-card">
        <div class="card-head">
          <div class="chart-tools" role="group" aria-label="Chart series">
            <button class="chip on" data-series="score">Score</button>
            <button class="chip" data-series="acute">Crisis now</button>
            <button class="chip" data-series="structural">Structural risk</button>
            <button class="chip" data-series="stagflation">Stagflation index</button>
            <button class="chip" data-series="recession_risk">Recession probability</button>
            <button class="chip" data-series="money">Inflation &amp; money</button>
            <button class="chip" data-series="fiscal">Debt &amp; fragility</button>
            <button class="chip" data-series="buildup">Build-up</button>
          </div>
          <p class="legend small muted">
            <span><span class="key crisis"></span> crisis episodes</span><span><span class="key rec"></span> US recessions (NBER)</span><span><span class="key bear"></span> start of a 20% stock-market fall</span>
          </p>
        </div>
        <div class="chart">
          <svg id="history" role="img" aria-label="Score history since 1973"></svg>
          <div class="tip" id="tip" hidden></div>
        </div>
      </div>
      <div class="card"><div class="scorecard" id="scorecard"></div></div>
    </section>

    <section class="section" id="outlook-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">05</span>The long run · not in the score</p><h2 class="section-title">How much is left? The next ten years</h2></div>
        <p class="lede">The score asks whether something breaks in the next year or two. This asks something else: what US stocks have returned over the following decade when they started from prices like today's, and what Treasuries pay instead. Expensive markets say little about when they fall, but they have reliably meant less to come.</p></header>
      <div class="outlook-grid tiles">
        <div class="card ol"><p class="ov" id="ol-stocks">--</p><p class="ot">US stocks: expected return a year after inflation, next 10 years</p><p class="muted tiny" id="ol-stocks-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="ol-bonds">--</p><p class="ot">10-year inflation-protected Treasuries: yield after inflation, locked in if held</p><p class="muted tiny" id="ol-bonds-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="ol-neg">--</p><p class="ot">Chance stocks lose money after inflation over the decade</p><p class="muted tiny" id="ol-neg-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="ol-tips">--</p><p class="ot">Chance stocks do worse than those Treasuries</p><p class="muted tiny">from the model's past misses</p></div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-head"><h3>Beyond history</h3><span class="meta">today vs the highest with a known 10-year outcome</span></div>
          <table class="mini" id="beyond-table"></table>
          <p class="small muted">No month with a known outcome was this stretched, so no model is fitted on these: any number would be extrapolation. They point the same way as the CAPE-based estimate, only further.</p>
        </div>
        <div class="card prose-card"><h3>How sure is this?</h3><p class="muted small" id="ol-how">&nbsp;</p></div>
      </div>
    </section>

    <section class="section" id="society-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">06</span>Society and politics · partly in the score</p><h2 class="section-title">What the news says</h2></div>
        <p class="lede">The rest of the score reads markets, money and debt. This reads the papers and the surveys: policy uncertainty, geopolitical risk, polarisation, migration fear, trade, the tone of economic news, Europe's mood and unrest, each against its own history. Policy uncertainty and geopolitical risk are in the score since v7; the rest is shown, not scored.</p></header>
      <div class="outlook-grid society-grid tiles">
        <div class="card ol"><p class="ov" id="so-us">--</p><p class="ot">US economic policy uncertainty in the news, percentile since 1900</p><p class="muted tiny" id="so-us-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-eu">--</p><p class="ot">Europe economic policy uncertainty in the news, percentile since 1987</p><p class="muted tiny" id="so-eu-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-gpr">--</p><p class="ot">Geopolitical risk in the news, percentile since 1900</p><p class="muted tiny" id="so-gpr-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-pci">--</p><p class="ot">Partisan conflict in Washington in the news, percentile since 1981</p><p class="muted tiny" id="so-pci-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-mig">--</p><p class="ot">Migration fear in the news, US, UK and Germany, average percentile since 1990</p><p class="muted tiny" id="so-mig-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-tpu">--</p><p class="ot">US trade policy uncertainty in the news, percentile since 1960</p><p class="muted tiny" id="so-tpu-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-news">--</p><p class="ot">How negative US economic news is, percentile of days since 1980</p><p class="muted tiny" id="so-news-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-euconf">--</p><p class="ot">How gloomy European households are, percentile since 1985</p><p class="muted tiny" id="so-euconf-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="so-unrest">--</p><p class="ot">Countries with major social unrest in the last 12 months</p><p class="muted tiny" id="so-unrest-note">&nbsp;</p></div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-head"><h3>Unrest in the news, by country</h3><span class="meta">percentile vs its own months since 1990</span></div>
          <table class="mini" id="unrest-table"></table>
          <p class="small muted">Each country's share of news about protests, riots and strikes (IMF Reported Social Unrest Index). The IMF publishes it a few months late, so the latest unrest is not here yet.</p>
        </div>
        <div class="card prose-card"><h3>In the score?</h3><p class="muted small"><b>Policy uncertainty: yes</b>, a double-weight theme of the stress pillar, about a tenth of the score. It rises as trouble arrives rather than before (since 1973 it averaged the 85th percentile in the month a crisis began, against about the 70th in the two years before), so it says something is happening, not that something is coming. <b>Geopolitical risk: yes, the other way round.</b> Since 1900, calm years came before crises and recessions far more often than tense ones (the late 1990s, 2018–19, 2021), a pattern found in 1905–72 and confirmed after 1973, so a calm past year adds to build-up and today's tension pulls it down. <b>Unrest: no</b>, its one pass in testing rested on two coincidences (see How the formula evolved). <b>Polarisation, migration fear, trade, the tone of the news and Europe's mood: no</b>, tested in October 2026 against today's score and none made it better at warning of crises. The tone of the news flags a crisis under way about as well as anything here, but markets get there first. Anger and polarisation mostly follow financial crises: far-right vote share has risen by about a third in the five years after one (Funke, Schularick and Trebesch, 2016). Sources: Baker, Bloom and Davis, policyuncertainty.com (policy uncertainty, migration fear); Caldara and Iacoviello, Federal Reserve Board (CC BY 4.0); Caldara, Iacoviello, Molligo, Prestipino and Raffo (trade, CC BY); Azzimonti, Federal Reserve Bank of Richmond (partisan conflict); Shapiro, Sudhof and Wilson, Federal Reserve Bank of San Francisco (news sentiment); European Commission via Eurostat (consumer confidence); IMF Reported Social Unrest Index (Barrett, Appendino, Nguyen and de Leon Miranda).</p></div>
      </div>
    </section>

    <section class="section" id="households-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">07</span>Households · not in the score</p><h2 class="section-title">What a pay cheque buys, 1970 and now</h2></div>
        <p class="lede">House prices against pay, the cost of a mortgage, the misery index, how people feel, how much they save, and who gets what. All official figures, each against its own history. Tested against fifty years of crises and 35 years of unrest in 46 countries, none of it warned of either, so it is shown here and not scored.</p></header>
      <div class="outlook-grid tiles">
        <div class="card ol"><p class="ov" id="hh-strain">--</p><p class="ot">Household strain index, 0–100: housing, prices and jobs, mood, savings and fairness against their own history</p><p class="muted tiny" id="hh-strain-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="hh-years">--</p><p class="ot">Years of a typical worker's full-time pay to buy the median new home</p><p class="muted tiny" id="hh-years-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="hh-ceo">--</p><p class="ot">CEO pay against a typical worker's (Economic Policy Institute)</p><p class="muted tiny" id="hh-ceo-note">&nbsp;</p></div>
        <div class="card ol"><p class="ov" id="hh-gap">--</p><p class="ot">Output per hour against a typical worker's pay after inflation, since 1970</p><p class="muted tiny" id="hh-gap-note">&nbsp;</p></div>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-head"><h3>1970 and now</h3><span class="meta">red: worse than 85% of its own history</span></div>
          <table class="mini" id="hh-table"></table>
          <p class="small muted">A typical worker: production and non-supervisory employees, about four in five private jobs, paid for 40 hours a week. The mortgage assumes 20% down and a 30-year fixed loan at Freddie Mac's average rate. Where a series starts after 1970, its first year is shown.</p>
        </div>
        <div class="card prose-card">
          <div class="card-head"><h3>Household strain since <span id="hh-since">1964</span></h3><span class="meta">yearly average · not in the score</span></div>
          <svg id="hh-chart" role="img" aria-label="Household strain index by year"></svg>
          <p class="muted small"><b>Not in the score.</b> Every measure here was tested in October 2026 like any other input. Added to the score, none made crisis, recession or severe-crisis warning better than adding a random series did: random slow-moving series raise crisis warning two years ahead by up to 0.02 of AUC, and the best of these, household credit growth and debt service, by 0.021. On its own the strain index warned of crises two years ahead at an AUC of 0.57, against the score's 0.87. Inside the recession model, none helped either.</p>
          <p class="muted small"><b>Does strain lead to unrest? Not in the data.</b> Across 46 countries since 1991 (the IMF's unrest index against each country's unemployment, inflation, misery index, food prices and consumer confidence), none of these came before flare-ups more often than chance (AUC 0.42 to 0.53), in 1991–2007 or after. In the US the strain index did no better than a coin flip on the ten flare-ups since 1994, George Floyd and Dobbs among them. Unrest tends to follow a trigger, such as a killing, a court ruling, a reform or an election, rather than the slow build-up these numbers measure.</p>
          <p class="muted small"><b>Does unrest hurt the economy?</b> Before 2008, in the year after a flare-up, unemployment rose 0.2 points more than usual and stocks did about 5% worse, but that unrest mostly came with crises already under way (Argentina and Turkey in 2001). Since 2008 there is no measurable effect, and in no period did flare-ups come before 20% stock falls. Read this panel as how stretched households are, not as a forecast.</p>
          <p class="muted tiny">Sources: US Census Bureau, BLS, BEA and FHFA via FRED; Freddie Mac (mortgage rates); University of Michigan Surveys of Consumers; Federal Reserve (debt service; Distributional Financial Accounts); the Economic Policy Institute's State of Working America Data Library (CEO pay, productivity and pay); IMF Reported Social Unrest Index and OECD (the unrest study).</p>
        </div>
      </div>
    </section>

    <section class="section" id="cases-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">08</span>Concrete examples</p><h2 class="section-title">What it said before, during and after</h2></div>
        <p class="lede">Ten moments from the last fifty years, scored with only the data that existed at the time.</p></header>
      <div class="cases tiles" id="case-list"></div>
    </section>

    <section class="section" id="forecast-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">09</span>The early-warning model</p><h2 class="section-title">Recession probability, next 12 months: <span class="gold" id="fc-prob">--</span></h2></div></header>
      <div class="grid-3">
        <div class="card prose-card">
          <p>
            The early-warning pillar is a forecasting model built on the two signals with the best record for calling US
            recessions a year ahead: <strong>the yield curve</strong> and <strong>financial conditions</strong>, plus the
            credit market's risk appetite.
          </p>
          <ul class="ticks">
            <li><strong>Yield curve.</strong> When 3-month Treasury bills pay more than 10-year bonds, the market expects the Fed to cut because growth is about to weaken. Every US recession since 1969 was preceded by an inversion, usually 6–24 months earlier and often after the curve had started to un-invert, so the model also looks at the deepest inversion of the last 18 months.</li>
            <li><strong>Financial conditions.</strong> The Chicago Fed's NFCI combines 105 measures of money-market, debt and equity conditions and of bank lending. Tight and tightening conditions starve the economy of credit.</li>
            <li><strong>Excess bond premium.</strong> The part of corporate bond spreads not explained by default risk: when it rises, lenders are losing their nerve.</li>
          </ul>
          <p class="muted small">Logistic regression with a ridge penalty, trained on monthly data since 1971 to answer "does a recession start within 12 months?". Refitted each January using only outcomes already known; backtested out of sample from 1979.</p>
          <p class="muted small">Why it can read lower than economists’ surveys or betting markets: it counts only what has come before past recessions, and a deep inversion alone isn’t enough while financial conditions and credit spreads stay calm. The <a href="https://www.newyorkfed.org/research/capital_markets/ycfaq" target="_blank" rel="noopener">New York Fed’s model</a> uses the yield curve alone, so the two can differ.</p>
        </div>
        <div class="card"><div class="card-head"><h3>Today's inputs</h3><span class="meta">model weights</span></div><table class="mini" id="fc-inputs"></table></div>
        <div class="card"><div class="card-head"><h3>Out-of-sample track record</h3></div><table class="mini" id="fc-track"></table><p class="small muted" id="fc-note"></p></div>
      </div>
    </section>

    <section class="section" id="lead-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">10</span>Learning from past crises</p><h2 class="section-title">What moves before a crisis</h2></div>
        <p class="lede">Every crisis and 20% stock-market fall since 1973, lined up on the month it started. Market gauges stay ordinary until the month trouble hits; the signals that move earlier are in the economy and the credit cycle. None of them can see an overnight crash coming.</p></header>
      <div class="grid-2">
        <div class="card">
          <div class="card-head"><h3>Average percentile around the start of <span id="lead-n"></span> episodes</h3><span class="meta">50 = an ordinary month</span></div>
          <svg id="leadchart" role="img" aria-label="How signals behaved before and after past crises"></svg>
          <p class="legend small muted" id="lead-legend"></p>
        </div>
        <div class="card">
          <div class="card-head"><h3>Pre-crisis checklist</h3><span class="meta">today vs 6 months before past crises</span></div>
          <table class="mini" id="lead-table"></table>
          <p class="small muted">AUC: how well a high reading flagged an event starting within 12 months (0.5 = coin flip). We tested these and more inside the score itself: none improved it, because the pillars already carry their information, so they're shown here as context. The recession probability didn't move either: adding claims, permits, lending standards, unemployment or inflation to its model left its reading between 7% and 9% (tested October 2026) and none improved its out-of-sample record.</p>
        </div>
      </div>
    </section>

    <section class="section" id="stag-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">11</span>Inflation, the Fed and the worst cases</p><h2 class="section-title">Stagflation, or worse?</h2></div>
        <p class="lede"><strong>Stagflation</strong> is inflation that stays high while the economy weakens: the 1970s, 1980–82, briefly 1990 and 2008. We define it as inflation of 5% or more while unemployment has risen at least half a point from its 12-month low.</p></header>
      <div class="grid-3">
        <div class="card">
          <div class="card-head"><h3>Stagflation index</h3><span class="meta">inflation &amp; money + warning</span></div>
          <p class="big"><span id="stag-now">--</span><small>/100</small></p>
          <table class="mini" id="stag-table"></table>
        </div>
        <div class="card">
          <div class="card-head"><h3>Inflation: official and alternative</h3><span class="meta">percentile</span></div>
          <table class="mini" id="infl-table"></table>
          <p class="small muted">
            What about "real" inflation? The best-known alternative, ShadowStats, is a paid service that doesn't recompute
            the data: its creator has said it adds a constant to the official figures (<a href="https://econbrowser.com/archives/2008/10/shadowstats_res" target="_blank" rel="noopener">Econbrowser, 2008</a>), and BLS economists have rebutted its claims (<a href="https://www.bls.gov/opub/mlr/2008/08/art1full.pdf" target="_blank" rel="noopener">Monthly Labor Review, 2008</a>).
            Instead we track the measures Federal Reserve banks build to see through noise. Producer prices and oil show the pressure still in the pipeline.
          </p>
        </div>
        <div class="card">
          <div class="card-head"><h3>The Fed's stance</h3></div>
          <table class="mini" id="fed-table"></table>
          <div class="card-head spaced"><h3>Hyperinflation checklist</h3></div>
          <ul class="checklist" id="hyper"></ul>
          <p class="small muted">Conditions seen before hyperinflations elsewhere (Germany 1923, Hungary 1946, Zimbabwe 2008, Venezuela 2018). The US has never had one, so this can't be backtested here.</p>
        </div>
      </div>
    </section>

    <section class="section" id="markets-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">12</span>Same metal, many markets</p><h2 class="section-title">Gold, priced everywhere at once</h2></div>
        <p class="lede">No government sets the price of gold. It trades around the clock in London, New York, Shanghai, Zurich, Mumbai and on-chain, and arbitrage keeps every venue within a few dollars of the others. When a venue drifts, metal flows to it; a dislocation is an early sign that a market is breaking.</p></header>
      <div class="grid-2">
        <div class="card">
          <div class="card-head"><h3>Live venues</h3><span class="meta">vs the median</span></div>
          <div class="tug" id="tug"><div class="lane" id="lane"></div></div>
          <table class="mini" id="venue-table"></table>
          <p class="small muted">Tokenised gold (PAXG, XAUT) is backed by allocated London bars and trades 24/7; central-bank references are once-a-day fixes.</p>
        </div>
        <div class="card"><div class="card-head"><h3>Gold in ten currencies</h3><span class="meta">1-year change</span></div><table class="mini" id="ccy-table"></table></div>
      </div>
      <div class="card">
        <div class="card-head"><h3>Markets that should agree</h3><span class="meta">today vs their usual gap</span></div>
        <table class="mini" id="pairs-table"></table>
        <p class="small muted">Prices that arbitrage or the Fed normally hold together. "Usual" is the middle half of past days; a gap wider than on 99% of them goes to the top of the page. Shanghai uses the Shanghai Futures Exchange's most-traded contract (we show only the premium, as its terms allow) against the National Bank of Poland's fix; New York uses Coinbase's COMEX-settled gold future against PAX Gold. Shown for awareness: none of these is in the score.</p>
      </div>
    </section>

    <section class="section" id="debt-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">13</span>The fiscal fuse</p><h2 class="section-title">Debt keeps compounding</h2></div></header>
      <div class="card debt-counter">
        <p class="eyebrow">US federal debt · live estimate</p>
        <p class="counter" id="counter">$--</p>
        <p class="small muted" id="counter-note"></p>
      </div>
      <div class="grid-2">
        <div class="card">
          <div class="card-head"><h3>US net foreign debt, % of GDP</h3><span class="meta">net international investment position</span></div>
          <svg id="niip" role="img" aria-label="US net foreign debt as a share of GDP since 1976"></svg>
          <p class="small muted" id="niip-note"></p>
        </div>
        <div class="card">
          <div class="card-head"><h3>Gross external debt, % of GDP</h3><span class="meta">bar = 2026 · white line = 2011</span></div>
          <div id="ext-bars" class="bars"></div>
          <p class="small muted">World Bank / IMF Quarterly External Debt Statistics (CC BY 4.0). Debt owed abroad by governments, banks and companies. High numbers are normal for financial centres like London and Paris; what matters is the trend.</p>
        </div>
        <div class="card"><div class="card-head"><h3 id="gov-title">Government debt, % of GDP</h3><span class="meta">bar = latest · white line = 2007</span></div><div id="gov-bars" class="bars"></div></div>
        <div class="card">
          <div class="card-head"><h3>Central-bank gold</h3><span class="meta">tonnes · 12-month change</span></div>
          <table class="mini" id="cb-table"></table>
          <p class="small muted">IMF International Liquidity data, monthly, about two months behind.</p>
        </div>
      </div>
    </section>

    <section class="section method" id="method-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">14</span>How it works</p><h2 class="section-title">The method, in plain English</h2></div></header>
      <div class="steps tiles">
        <div class="card step">
          <span class="step-n">1</span><h3>Collect</h3>
          <p class="muted"><span id="n-series">143</span> public series from the Federal Reserve, FRED, the US Treasury, the OFR, the ECB, the IMF, the World Bank, two central banks and exchange tickers. Every 15 minutes a script refreshes what is due: prices each run, daily data twice a day, monthly data daily, IMF and World Bank data weekly. A due series is re-read in full, some back to 1854, because publishers revise the past.</p>
        </div>
        <div class="card step">
          <span class="step-n">2</span><h3>Compare with history</h3>
          <p class="muted">A VIX of 30 or a debt ratio of 120% means little on its own. Each measure is turned into a percentile: the share of all past months in which it was lower. 90 means "higher than 90% of history".</p>
        </div>
        <div class="card step">
          <span class="step-n">3</span><h3>Five questions</h3>
          <p class="muted"><strong>Stress now</strong>: is a crisis happening? <strong>Early warning</strong>: is a recession coming? <strong>Inflation &amp; money</strong>: is money losing value? <strong>Debt &amp; fragility</strong>: how much could break? <strong>Build-up</strong>: are excesses building? Inside each pillar, inputs measuring the same thing are averaged first, so no theme is counted twice.</p>
        </div>
        <div class="card step">
          <span class="step-n">4</span><h3>One score, two readings</h3>
          <p class="muted">Score = (2 × stress + warning + money + fiscal + build-up) ÷ 6. Stress counts double because it is the only pillar that says a crisis is actually happening. "Crisis now" = (2 × stress + warning) ÷ 3; "structural risk" = the average of the three slow pillars.</p>
        </div>
      </div>
      <div class="grid-2">
        <div class="card prose-card"><h3>What it is good at</h3><p class="muted" id="good-at"></p></div>
        <div class="card prose-card">
          <h3>What it can't do</h3>
          <p class="muted">
            It can't see shocks that come from outside finance, like a pandemic, a war or a sudden crash with no build-up (Black
            Monday in 1987 barely registered beforehand). The yield curve can cry wolf: its deepest inversion since 1981,
            in 2022–24, has not been followed by a recession. Debt doesn't time crises at all; it decides how much damage
            one can do. And a backtest with a dozen crises is a small sample: treat the score as a thermometer with a weather
            forecast attached, not a prophecy.
          </p>
        </div>
      </div>
      <div class="card versions">
        <div class="card-head"><h3>How the formula evolved</h3><span class="meta">v1–v7 October 2026 · each backtested from 1973</span></div>
        <ol>
          <li><strong>v1 · Market stress.</strong> Stress indices, credit spreads, VIX, plus a blend of the yield curve, debt and gold. Good at saying a crisis is happening; weak at saying one is coming.</li>
          <li><strong>v2 · The recession model.</strong> The yield curve and financial conditions became a proper forecasting model, refitted every year on outcomes already known. Recession warning a year ahead improved to an AUC of about 0.9.</li>
          <li><strong>v3 · Inflation, the Fed and debt.</strong> Added official and alternative inflation, inflation expectations, money growth, the dollar, the deficit, r − g, foreign debt, G7 debt and bond sell-offs, plus unemployment. Tested and rejected for the forecast: the Fed funds rate, its pace of hikes, the real policy rate and the 10-year minus 2-year curve, which added nothing the 10-year minus 3-month curve didn't already know (it is, in effect, the market's read of Fed policy). Debt measures don't time crises at all, so they shape structural risk rather than the warning.</li>
          <li><strong>v4 · Valuations, leverage and a consistency fix.</strong> Added the value of US company shares against GDP (a record 255% at the time, including privately held firms; about 210% for listed companies alone) and corporate debt against GDP, one of the better predictors of 20% stock falls (AUC 0.77 a year ahead). Switched r − g to the rate new borrowing costs, and debt growth to after-inflation terms, so the high-inflation 1970s no longer flatter today. Fixed the history to use the same latest-known inputs as the live reading (it had been dropping slow quarterly series in recent months) and a gap left by the October 2025 shutdown, when no CPI or unemployment data was published. Every target backtests as well or better.</li>
          <li><strong>v5 · Fairer averaging and calibrated labels.</strong> Inputs that measure the same thing are now averaged together first (eight consumer-inflation measures had been outvoting producer prices, expectations and the dollar; four stress indices outvoted the rest), which improved crisis warning a year ahead from 0.73 to 0.75. Bands are now set where the historical odds actually change, and the page shows those odds: the old "calm" label covered months whose odds were average. Tested and rejected: weights fitted by a model (worse out of sample: a dozen crises are too few to fit weights on) and an oil-shock signal (no added power; oil was then just below its three-year high).</li>
          <li><strong>v6 · Credit build-up, funding stress, honest timing.</strong> A fifth pillar, build-up, asks whether excesses are building: how fast private debt has outgrown the economy over three years (BIS data) and how cheap credit was two years earlier, the two signals research finds before banking crises (Greenwood, Hanson, Shleifer and Sørensen, 2022; López-Salido, Stein and Zakrajšek, 2017). The stress pillar gained funding dislocations: what banks pay to borrow for three months over T-bills, and the VIX above its three-month version. Quarterly data now enters the history only once it was published, not at the quarter it describes. The test for accepting the change was fixed before running it, and it passed: crisis warning two years ahead rose from 0.77 to 0.86, recession and severe-crisis warning improved too, in both 1973–99 and since 2000, and months scoring 60 or more in the 2022–24 false alarm fell from 24 to 5. "Systemic breakdown" now starts at 75, which keeps it to 1974, 1980 and 2008–09. It lowered the reading of October 2026 from 48 to 46: private credit has shrunk against GDP for three years, unlike before 2008. Tested and rejected: more weight on stock valuations (company shares against GDP, the CAPE ratio and households' share in stocks were in their top tenth in 79% of months since 1995; they predict ten-year returns, not crises), a credit-and-asset-boom trigger, counts of sudden moves, credit growth in the recession model, and famous investors' warnings, which can't be backtested.</li>
          <li><strong>v7 · Policy uncertainty and geopolitics.</strong> Two newspaper-based measures joined at the owner's request, under a no-harm rule set before testing: the score could not get worse at warning of crises, recessions or severe crises, and neither 1973–99 nor 2000+ could lose ground. Policy uncertainty in the US and Europe (Baker, Bloom and Davis) is a stress theme at double weight: it rises as trouble arrives and flags crises under way about as well as unemployment does, and double was the most weight history allowed before crisis warning two years ahead fell below v6 (triple lost ground). Geopolitical risk (Caldara and Iacoviello, since 1900) went in the other way round: calm years came before crises and recessions far more often than tense ones, a pattern found in 1905–72 and confirmed after 1973, so a calm past year now adds to build-up. Together they improved crisis warning two years ahead slightly (AUC 0.863 → 0.870).</li>
          <li><strong>Correction after v7 · smoother odds cards.</strong> The cards counted only months within 3 points of today's score, so a one-point move could swing them by 10 points or more. Every month now counts, weighted by how close its score was (half weight 6 points away). Tested walk-forward since 1990 against windows of ±3, ±5 and ±8 points, other weightings and a fitted curve: it predicted what followed better than the ±3 window on all five cards (Brier score 3–8% lower), and the odds move a quarter to a half less per point. At a score of 51: a crisis within two years 64% → 57%, a severe one 25% → 19%. The score is unchanged.</li>
          <li><strong>Research after v7 · households, inequality and unrest.</strong> Tested against the acceptance rule, with the live v7 score as the baseline: house prices against pay and family income, the mortgage payment on a median home against pay, house prices against rents, real house-price growth, household credit and debt service, the misery index, real wages, consumer sentiment, the saving rate, labour's share of income, the productivity-pay gap, CEO-to-worker pay, the Gini index and the top 1%'s share of wealth, each in every pillar, as levels and as changes, and inside the recession model. None passed. The best, household credit growth and debt service as stress themes, added 0.021 to crisis warning two years ahead, but random slow-moving series added that way gain up to 0.019, so a test of the whole score can't tell them from noise. A fairer test, built the same week, looks at the information itself (among months the score rates alike, does the input still pick out the months before a crisis?) and finds that household credit growth and debt service do carry some. A household strain index built from these did no better (crisis warning 0.57 on its own, against the score's 0.87). A study of 46 countries since 1991 then asked whether strain leads to unrest and unrest to economic damage: unemployment, inflation, the misery index, food prices and consumer confidence came before the IMF's unrest flare-ups no more often than chance, before 2008 or after; unrest was followed by weaker jobs and stocks before 2008 (mostly unrest during crises already under way) and by nothing measurable since. The measures are shown in the households panel, outside the score.</li>
          <li><strong>Research after v7 · polarisation, migration, trade, news tone, Europe's mood.</strong> Tested against the acceptance rule with the live v7 score as the baseline: partisan conflict (Azzimonti), migration fear (US, UK, Germany), trade policy uncertainty, the tone of economic news (San Francisco Fed), EU consumer confidence, stock-market volatility in the news, and policy uncertainty about sovereign debt and about monetary policy, each as a stress theme; calm forms of news tone, confidence, volatility news and partisan conflict in build-up; and news tone inside the recession model. The best, volatility news and debt uncertainty together, added 0.011 to crisis warning two years ahead, against the 0.03 the rule asks for, with a confidence range that includes zero, and it was the best two of fifteen tries. News tone flags crises under way better than any other newspaper measure (AUC about 0.9), but the stress pillar already knows from markets, and inside the recession model it made out-of-sample accuracy worse (0.89 to 0.81–0.85). All are shown in the society panel, outside the score.</li>
          <li><strong>Research for v7 · society and politics.</strong> Tested and rejected: policy uncertainty and geopolitical risk inside the recession model (out-of-sample accuracy the same or worse, with unstable signs), geopolitical risk as a measure of stress now (it flags crises under way barely better than chance), global policy uncertainty and the IMF's World Uncertainty Index (no meaningful gain anywhere), and social unrest (IMF). Unrest's one pass, the number of countries with major unrest rising over a year, came entirely from the 2019 protest wave before Covid and the Arab Spring before the 2011 euro crisis, and the IMF dates its events partly with hindsight; it is shown above, outside the score. Election results (ParlGov) stop in June 2023, too stale for a live monitor.</li>
          <li><strong>Correction after v6 · the odds cards.</strong> "What followed months like this one" counted months already inside a crisis (and months inside a recession, as if none had started), which overstated the crisis odds for a month like today, when none is under way. The cards now compare only months not already in the event (20 October 2026: crisis starting within 12 months 60% → 51%, against an average month of 44% → 29%). The score and its bands are unchanged.</li>
          <li><strong>Research after v6 · household credit and the 10-year yield.</strong> Tested against the same rule and rejected, none adding anything the score didn't already know: credit-card, consumer, mortgage and auto-loan delinquencies, the Treasury term premium, the Italy–Germany bond spread, the real 10-year yield, its 12-month change, long rates rising while the Fed cuts, and two refinements of the yield curve (stripping out the term premium cut recession warning from 0.90 to 0.73). Stock valuations and the AI investment boom went into a separate long-run panel instead, where the evidence for them is: they predict ten-year returns.</li>
          <li><strong>Research after v5 · signals before crises.</strong> An event study of 20 crisis and crash starts showed market gauges (stress indices, VIX, credit spreads, stock trends) don't move until the month trouble hits; if anything, volatility is unusually low three months before. Building permits, bank lending standards and jobless claims did move earlier and are shown in the pre-crisis checklist, but adding them to the score or the recession model didn't improve either out of sample, so the formula is unchanged.</li>
        </ol>
      </div>
      <p class="muted small">
        Inspired by the long-gone <a href={ARCHIVE} target="_blank" rel="noopener">didthesystemcollapse.com</a>, which compared
        London and Shanghai gold prices; its "NOT YET" was a switch flipped by hand. This one is computed. Nothing here is
        financial advice.
      </p>
    </section>

    <section class="section" id="feeds-s">
      <header class="sec-head"><div><p class="eyebrow"><span class="num">15</span>Data feeds</p><h2 class="section-title">Sources, live status</h2></div>
        <p class="lede">Everything on this page comes from one public JSON file, rebuilt every 15 minutes: <a href="/live/collapse.json"><code>/live/collapse.json</code></a>. Each series stays under its publisher's terms; our scores are free to reuse under <a href={LICENSE} target="_blank" rel="noopener">CC BY 4.0</a>.</p></header>
      <pre class="terminal" id="terminal" data-nosnippet>$ connecting to willthesystemcollapse.com/live/collapse.json …</pre>
    </section>
  </main>

  <Footer />
</Base>

<script>
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const BAND_COLORS: Record<string, string> = { calm: '#6fbf8e', normal: '#a9c46c', elevated: '#d9b45a', high: '#e8923a', crisis: '#e05a47', systemic: '#b3261e' };
  // [title, full view, simple view]; the simple line for the warning pillar gets the recession probability
  const PILLAR_COPY: Record<string, [string, string, string]> = {
    stress: ['Stress now', 'Is a crisis happening? Financial-stress indices, the VIX, credit spreads, the stock drawdown, unemployment, funding dislocations (banks paying up to borrow, near-term fear above longer-term) and policy uncertainty in the news, US and Europe, at double weight.', 'Is something breaking right now? Market fear, credit spreads, bank funding, policy uncertainty.'],
    warning: ['Early warning', 'Is a recession coming within a year? The yield-curve and financial-conditions model, as a percentile of its own history.', 'Is a recession coming?'],
    money: ['Inflation & money', 'Is money losing value? Official and alternative inflation, expectations, money growth, the dollar and gold.', 'Is money losing value? Inflation, money growth, the dollar, gold.'],
    fiscal: ['Debt & fragility', 'How much could break? Government and corporate debt, deficits, the interest bill, r − g, foreign debt, stock valuations and bond sell-offs.', 'How much could break? Government and company debt, deficits, stock prices.'],
    buildup: ['Build-up', 'Are excesses building? How fast private debt has outgrown the economy over three years, how cheap credit was two years ago (the two signals that come before banking crises) and how calm geopolitics has been over the past year: calm years have come before crises more often than tense ones.', 'Are excesses building? Private debt growth, cheap credit, complacency.'],
  };
  const PILLARS = ['stress', 'warning', 'money', 'fiscal', 'buildup'];
  const money = (v: number, d = 2) => '$' + v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
  const num = (v: number, d = 2) => v.toLocaleString('en-US', { minimumFractionDigits: d, maximumFractionDigits: d });
  const pctf = (v: number, d = 1) => (v > 0 ? '+' : '') + (100 * v).toFixed(d) + '%';
  const monthName = (m: string) => new Date(m + '-01T00:00:00Z').toLocaleDateString('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
  const ago = (iso: string) => {
    const s = (Date.now() - Date.parse(iso)) / 1000;
    return s < 90 ? 'just now' : s < 3600 ? `${Math.round(s / 60)} min ago` : s < 86400 ? `${Math.round(s / 3600)} h ago` : `${Math.round(s / 86400)} days ago`;
  };
  const bandOf = (score: number, bands: any[]) => bands.filter((b) => score >= b.at).pop();

  // ---------- gauge ----------
  function arc(a0: number, a1: number, r: number) {
    const p = (v: number) => {
      const t = Math.PI * (1 - v / 100);
      return `${160 + r * Math.cos(t)} ${160 - r * Math.sin(t)}`;
    };
    return `M ${p(a0)} A ${r} ${r} 0 0 1 ${p(a1)}`;
  }
  function drawGauge(d: any) {
    const bands = d.bands;
    $('gauge-bands').innerHTML = bands
      .map((b: any, i: number) => `<path d="${arc(b.at, bands[i + 1]?.at ?? 100, 130)}" stroke="${BAND_COLORS[b.key]}" class="gband"/>`)
      .join('');
    const marks = d.backtest.crises.filter((c: any) => ['2008', '1973', '2020'].includes(c.start.slice(0, 4)));
    $('gauge-marks').innerHTML = marks
      .map((c: any) => {
        const t = Math.PI * (1 - c.peak / 100);
        const x = 160 + 150 * Math.cos(t), y = 160 - 150 * Math.sin(t);
        return `<line x1="${160 + 118 * Math.cos(t)}" y1="${160 - 118 * Math.sin(t)}" x2="${160 + 142 * Math.cos(t)}" y2="${160 - 142 * Math.sin(t)}" class="mark"/><text x="${x}" y="${y}" class="mark-t" text-anchor="middle">${c.start.slice(0, 4)}</text>`;
      })
      .join('');
    ($('needle') as unknown as SVGGElement).style.transform = `rotate(${-90 + (180 * d.score) / 100}deg)`;
  }

  // ---------- pillars ----------
  const PILLAR_COLORS: Record<string, string> = { stress: '#e05a47', warning: '#8fb3ff', money: '#f0a35e', fiscal: '#c89cf0', buildup: '#6fc8c0' };
  function spark(vals: (number | null)[], color: string) {
    const v = vals.filter((x) => x != null) as number[];
    if (v.length < 2) return '';
    const W = 240, H = 44;
    const pts = v.map((y, i) => `${((W * i) / (v.length - 1)).toFixed(1)},${(H - (H * y) / 100).toFixed(1)}`);
    return `<svg class="spark" viewBox="0 0 ${W} ${H}" preserveAspectRatio="none" aria-hidden="true"><polyline points="0,${H} ${pts.join(' ')} ${W},${H}" fill="${color}" opacity=".12"/><polyline points="${pts.join(' ')}" fill="none" stroke="${color}" stroke-width="1.6" vector-effect="non-scaling-stroke"/></svg>`;
  }
  function drawPillars(d: any) {
    const last10 = (k: string) => d.history[k].slice(-120);
    const open = matchMedia('(min-width: 761px)').matches ? ' open' : '';  // phones start with the input lists folded
    $('pillars').innerHTML = PILLARS.filter((p) => p in d.pillars)  // a v5 JSON (mid-deploy) has no build-up pillar
      .map((p) => {
        const [title, text, short] = PILLAR_COPY[p];
        const v = d.pillars[p];
        const col = PILLAR_COLORS[p];
        const rows =
          p === 'warning'
            ? d.forecast.inputs
                .map((i: any) => `<li><span>${esc(i.label)}</span><b>${i.key === 'nfci' || i.key === 'nfci_chg6' ? i.value.toFixed(2) : (i.value > 0 ? '+' : '') + i.value.toFixed(2) + ' pp'}</b></li>`)
                .join('') + `<li class="strong"><span>Recession probability, 12 months</span><b>${d.forecast.probability.toFixed(0)}%</b></li>`
            : d.components
                .filter((c: any) => c.pillar === p)
                .sort((a: any, b: any) => b.pct - a.pct)
                .map((c: any) => `<li title="${esc(c.series)} · ${esc(c.date)}"><span>${esc(c.label)}</span><b>${esc(c.shown)}</b><i style="--p:${c.pct}%"></i><em class="${c.pct >= 85 ? 'hot' : ''}">${c.pct}</em></li>`)
                .join('');
        const weight = d.weights[p];
        const n = p === 'warning' ? d.forecast.inputs.length : d.components.filter((c: any) => c.pillar === p).length;
        const what = p === 'warning' ? `${n} model inputs` : `${n} inputs · percentile, 100 = worst on record`;
        return `<article class="card pillar" style="--pc:${col}">
          <div class="card-head"><h3>${title}</h3><span class="meta">weight ${weight}×</span></div>
          <p class="pv">${v.toFixed(0)}<small>/100</small></p>
          <div class="pbar"><i style="width:${v}%"></i></div>
          ${spark(last10(p), col)}<p class="tiny muted spark-cap">last 10 years</p>
          <p class="muted small full-only">${text}</p>
          <p class="small simple-only">${short}${p === 'warning' ? ` Chance one starts within 12 months: <b>${d.forecast.probability.toFixed(0)}%</b>.` : ''}</p>
          <details class="inputs"${open}><summary>${what}</summary><ul class="comp">${rows}</ul></details></article>`;
      })
      .join('');
  }

  // ---------- bands ----------
  function drawBands(d: any) {
    const bt = d.backtest;
    const th = Object.fromEntries(bt.thresholds.map((t: any) => [t.at, t]));
    const top = d.bands[d.bands.length - 1].at;
    const sys = d.history.months.filter((_: string, i: number) => d.history.score[i] >= top);
    const years = [...new Set(sys.map((m: string) => m.slice(0, 4)))];
    // the scale: coloured segments, today's marker and the worst crises
    const seg = d.bands
      .map((b: any, i: number) => `<span class="seg" style="--c:${BAND_COLORS[b.key]};flex:${(d.bands[i + 1]?.at ?? 100) - b.at}"><em>${esc(b.label)}</em></span>`)
      .join('');
    // labels sorted by position and staggered on two rows, so close peaks (2007 at 82, 1973 at 84) don't overlap
    const peaks = bt.crises
      .filter((c: any) => ['1974', '1980', '2007', '2020', '2022'].includes(c.start.slice(0, 4)) || c.start.startsWith('1973'))
      .sort((a: any, b: any) => a.peak - b.peak)
      .map((c: any, i: number) => `<span class="peak" style="left:${c.peak}%;--t:${i % 2 ? 20 : 6}px" title="${esc(c.label)}: ${c.peak}">${c.start.slice(0, 4)}</span>`)
      .join('');
    $('scale').innerHTML = `<div class="segs">${seg}</div><div class="marks">${peaks}<span class="today" style="left:${d.score}%"><b>${d.score.toFixed(0)}</b>today</span></div>`;
    $('bands').innerHTML = d.bands
      .map((b: any, i: number) => {
        const t = th[b.at];
        const next = d.bands[i + 1]?.at ?? 100;
        const inBand = d.odds.bins.filter((x: any) => x.lo >= b.at && x.lo < next);
        const n = inBand.reduce((a: number, x: any) => a + x.months, 0);
        const w = (k: string) => n ? Math.round(inBand.reduce((a: number, x: any) => a + x[k] * x.months, 0) / n) : null;
        const stat = n ? `<span><b>${w('crisis_12m')}%</b> within a year</span><span><b>${w('crisis_24m')}%</b> within two</span><span>${n} months</span>` : '<span>not enough history</span>';
        const active = d.band.key === b.key ? ' active' : '';
        return `<div class="bandcard${active}" style="--c:${BAND_COLORS[b.key]}"><span class="range">${b.at}–${next}</span><p class="ans">${esc(b.answer)}</p><p class="bl">${esc(b.label)}</p><p class="st">${stat}</p></div>`;
      })
      .join('');
    $('band-note').textContent = `Bands are set where the historical odds change: below 40, crises were rare; 40–50 is below the average month's odds; from 50 they are above it. On average ${bt.base}% of months were in a crisis or within a year of one. The score has reached ${top}+ only in ${years.join(', ')}: each time, governments or central banks had to step in to keep the system working.`;
  }

  // ---------- history chart ----------
  let chartData: any = null;
  let series = 'score';
  const geo = { W: 1000, L: 34, R: 8, n: 1 };  // chart geometry in real pixels, shared with the tooltip
  function drawHistory() {
    const d = chartData;
    const h = d.history;
    const n = h.months.length;
    const svg = $('history');
    const W = Math.max(300, svg.clientWidth), H = svg.clientHeight || 340, L = 34, R = 8, T = 10, B = 26;
    svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
    Object.assign(geo, { W, L, R, n });
    const every = W < 560 ? 10 : 5;
    const x = (i: number) => L + ((W - L - R) * i) / (n - 1);
    const y = (v: number) => T + (H - T - B) * (1 - v / 100);
    const idx = (m: string) => h.months.indexOf(m);
    let s = '';
    d.bands.forEach((b: any, i: number) => {
      const top = d.bands[i + 1]?.at ?? 100;
      s += `<rect x="${L}" y="${y(top)}" width="${W - L - R}" height="${y(b.at) - y(top)}" fill="${BAND_COLORS[b.key]}" opacity=".07"/>`;
    });
    d.backtest.crises.forEach((c: any) => {
      const a = idx(c.start), b = idx(c.end);
      if (a >= 0 && b >= 0) s += `<rect x="${x(a)}" y="${T}" width="${Math.max(2, x(b) - x(a))}" height="${H - T - B}" class="crisis"><title>${esc(c.label)}</title></rect>`;
    });
    // recessions (from the monthly NBER flags implied by start dates are approximate; draw a strip per recession start → 6+ months)
    d.events.recessions.forEach((m: string) => {
      const a = idx(m);
      if (a >= 0) s += `<rect x="${x(a)}" y="${H - B - 5}" width="${(W - L - R) / n * 8}" height="5" class="rec"/>`;
    });
    d.events.bear_markets.forEach((m: string) => {
      const a = idx(m);
      if (a >= 0) s += `<path d="M ${x(a)} ${H - B - 9} l -5 -9 h 10 z" class="bear"/>`;
    });
    for (let v = 0; v <= 100; v += 25) s += `<line x1="${L}" x2="${W - R}" y1="${y(v)}" y2="${y(v)}" class="grid"/><text x="${L - 6}" y="${y(v) + 4}" class="axis" text-anchor="end">${v}</text>`;
    h.months.forEach((m: string, i: number) => {
      if (m.endsWith('-01') && +m.slice(0, 4) % every === 0) s += `<text x="${x(i)}" y="${H - 8}" class="axis" text-anchor="middle">${m.slice(0, 4)}</text>`;
    });
    const vals = h[series];
    let path = '', pen = false;
    vals.forEach((v: number | null, i: number) => {
      if (v == null) { pen = false; return; }
      path += `${pen ? 'L' : 'M'}${x(i).toFixed(1)} ${y(v).toFixed(1)} `;
      pen = true;
    });
    s += `<path d="${path}" class="line ${series}"/>`;
    const li = vals.length - 1;
    if (vals[li] != null) s += `<circle cx="${x(li)}" cy="${y(vals[li])}" r="5" class="now"/>`;
    s += `<line id="cursor" x1="0" x2="0" y1="${T}" y2="${H - B}" class="cursor" visibility="hidden"/>`;
    $('history').innerHTML = s;
  }
  function hookChart() {
    const svg = $('history');
    const tip = $('tip');
    const show = (clientX: number) => {
      const d = chartData;
      if (!d) return;
      const r = svg.getBoundingClientRect();
      const { W, L, R } = geo;
      const fx = ((clientX - r.left) / r.width) * W;
      const n = d.history.months.length;
      const i = Math.max(0, Math.min(n - 1, Math.round(((fx - L) / (W - L - R)) * (n - 1))));
      const m = d.history.months[i];
      const h = d.history;
      const crisis = d.backtest.crises.find((c: any) => c.start <= m && m <= c.end);
      const cur = document.getElementById('cursor');
      const cx = String(geo.L + ((geo.W - geo.L - geo.R) * i) / (n - 1));
      cur?.setAttribute('x1', cx);
      cur?.setAttribute('x2', cx);
      cur?.setAttribute('visibility', 'visible');
      tip.hidden = false;
      tip.style.left = Math.min(r.width - 210, Math.max(0, clientX - r.left + 12)) + 'px';
      tip.innerHTML = `<b>${monthName(m)}</b><br>Score <b>${h.score[i].toFixed(0)}</b> · ${esc(bandOf(h.score[i], d.bands).label)}<br>Crisis now ${h.acute[i].toFixed(0)} · Structural ${h.structural[i].toFixed(0)}<br>Stress ${h.stress[i].toFixed(0)} · Warning ${h.warning[i].toFixed(0)} · Money ${h.money[i].toFixed(0)} · Fiscal ${h.fiscal[i].toFixed(0)}${h.buildup ? ` · Build-up ${h.buildup[i].toFixed(0)}` : ''}${h.recession_risk[i] != null ? `<br>Recession probability ${h.recession_risk[i].toFixed(0)}%` : ''}${crisis ? `<br><span class="gold">${esc(crisis.label)}</span>` : ''}`;
    };
    const hide = () => {
      tip.hidden = true;
      document.getElementById('cursor')?.setAttribute('visibility', 'hidden');
    };
    svg.addEventListener('mousemove', (e: MouseEvent) => show(e.clientX));
    svg.addEventListener('mouseleave', hide);
    // touch: drag a finger along the chart to read it
    svg.addEventListener('touchstart', (e: TouchEvent) => show(e.touches[0].clientX), { passive: true });
    svg.addEventListener('touchmove', (e: TouchEvent) => show(e.touches[0].clientX), { passive: true });
    svg.addEventListener('touchend', () => setTimeout(hide, 2500));
    let t = 0;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(() => chartData && (drawHistory(), drawDebt(chartData), drawLeads(chartData), drawHouseholds(chartData)), 200);
    });
    document.querySelectorAll<HTMLButtonElement>('.chip').forEach((b) =>
      b.addEventListener('click', () => {
        document.querySelectorAll('.chip').forEach((c) => c.classList.toggle('on', c === b));
        series = b.dataset.series!;
        if (chartData) drawHistory();
      }),
    );
  }

  function drawScorecard(d: any) {
    const t = d.backtest.targets;
    const cell = (r: any) => `${r.during ?? '—'} / ${r.ahead}`;
    const row = (k: string, name: string) =>
      `<tr><th>${name}</th><td>${t[k].events}</td><td>${cell(t[k].score)}</td><td>${cell(t[k].acute)}</td><td>${cell(t[k].structural)}</td><td>${cell(t[k].stagflation)}</td><td>${cell(t[k].model)}</td></tr>`;
    $('scorecard').innerHTML = `<table class="mini wide"><caption class="label">AUC during the event / in the 12 months before it (0.5 = coin flip, 1.0 = perfect)</caption>
      <thead><tr><th></th><th>Events</th><th>Score</th><th>Crisis now</th><th>Structural</th><th>Stagflation index</th><th>Recession model</th></tr></thead>
      <tbody>${row('recession', 'US recessions (NBER)')}${row('crisis', 'Crisis episodes (our list)')}${row('bear', 'US stocks fall 20%+')}${row('stagflation', 'Stagflation episodes')}</tbody></table>
      <div><p class="label">Each crisis: highest score in the 12 months before → during</p><div class="crisis-grid tiles">
      ${d.backtest.crises.map((c: any) => `<div class="cg" style="--c:${BAND_COLORS[bandOf(c.peak, d.bands).key]}"><span class="cg-m">${monthName(c.start)}</span><span class="cg-l">${esc(c.label)}</span><span class="cg-v"><em style="color:${BAND_COLORS[bandOf(c.before, d.bands).key]}">${c.before}</em> → <b>${c.peak}</b></span></div>`).join('')}
      </div></div>`;
  }

  function drawCases(d: any) {
    $('case-list').innerHTML = d.cases
      .map((c: any) => {
        const col = BAND_COLORS[bandOf(c.score, d.bands).key];
        const m = (k: string, label: string) => `<div><dt>${label}</dt><dd>${c[k]}</dd><i style="--w:${c[k]}%"></i></div>`;
        return `<article class="case card" style="--c:${col}">
          <div class="case-top"><p class="label">${monthName(c.month)}</p><p class="cscore"><b>${c.score}</b><span>${esc(c.band)}</span></p></div>
          <h3>${esc(c.title)}</h3><p class="muted small">${esc(c.text)}</p>
          <dl>${m('acute', 'Crisis now')}${m('structural', 'Structural')}${m('stress', 'Stress')}${m('warning', 'Warning')}${m('money', 'Money')}${m('fiscal', 'Fiscal')}${m('buildup', 'Build-up')}</dl>
          <p class="rp">${c.recession_risk != null ? `Recession probability <b>${c.recession_risk}%</b>` : 'Before the recession model had enough history'}</p></article>`;
      })
      .join('');
  }

  function drawForecast(d: any) {
    const f = d.forecast;
    $('fc-prob').textContent = f.probability.toFixed(0) + '%';
    $('fc-inputs').innerHTML = f.inputs
      .map((i: any) => `<tr><th>${esc(i.label)}</th><td>${i.value.toFixed(2)}</td><td class="muted">${i.weight > 0 ? 'higher = more risk' : 'lower = more risk'}</td></tr>`)
      .join('');
    const tr = f.track;
    $('fc-track').innerHTML =
      `<thead><tr><th>Model said</th><th>Recession began within 12 months</th><th>Months</th></tr></thead><tbody>` +
      tr.buckets.map((b: any) => `<tr><th>${b.lo}–${b.hi}%</th><td>${b.hit ?? '—'}%</td><td>${b.months}</td></tr>`).join('') +
      `<tr class="sub"><th>Recession</th><th>Highest probability in the year before</th><th>When</th></tr>` +
      tr.recessions.map((r: any) => `<tr><th>${monthName(r.start)}</th><td>${r.peak_before}%</td><td>${r.peak_month ? monthName(r.peak_month) : '—'}</td></tr>`).join('') + '</tbody>';
    $('fc-note').textContent = `Out-of-sample AUC ${tr.auc} since ${tr.since.slice(0, 4)}. Its high readings in 2022–24 were a false alarm, at least so far: the deepest inversion since 1981 was followed by a soft landing.`;
  }

  // ---------- markets ----------
  function drawVenues(d: any) {
    const m = d.markets;
    const live = m.venues.filter((v: any) => v.kind === 'token').sort((a: any, b: any) => a.price - b.price);
    const med = m.gold.price;
    $('venue-table').innerHTML = m.venues
      .map((v: any) => {
        const bps = ((v.price / med - 1) * 10000).toFixed(0);
        return `<tr><th>${esc(v.name)}</th><td>${money(v.price)}</td><td class="${+bps > 0 ? 'up' : +bps < 0 ? 'down' : 'muted'}">${+bps > 0 ? '+' : ''}${bps} bp</td><td class="muted">${v.kind === 'token' ? ago(v.at) : v.at}</td></tr>`;
      })
      .join('');
    if (live.length > 1) {
      const sp = m.spread;
      $('tug').dataset.cheap = live[0].name;
      $('tug').dataset.dear = live[live.length - 1].name;
      $('tug').style.setProperty('--speed', `${Math.max(1.2, 6 - sp.pct * 20)}s`);
      $('tug').setAttribute('data-label', `Spread ${money(sp.usd)} (${sp.pct.toFixed(2)}%) · metal flows to the dearer venue`);
      if (!$('lane').children.length) $('lane').innerHTML = Array.from({ length: 6 }, (_, i) => `<span style="animation-delay:${-i}s"></span>`).join('');
    }
    const gap = (g: any, v: number) => g.unit === '%' ? `${v >= 0 ? '+' : ''}${v.toFixed(2)}%` : g.unit === 'pp' ? `${v >= 0 ? '+' : ''}${v.toFixed(2)} pp` : g.unit === 'x' ? v.toFixed(2) : `$${v.toFixed(0)}bn`;
    $('pairs-table').innerHTML = `<thead><tr><th></th><th>Now</th><th>Usual</th><th></th></tr></thead><tbody>` + (d.pairs || [])
      .map((g: any) => `<tr><th>${esc(g.label)}</th><td class="${g.unusual ? 'down' : ''}">${gap(g, g.value)}</td><td class="muted">${g.usual ? `${gap(g, g.usual[0])} to ${gap(g, g.usual[1])}` : '—'}</td><td class="${g.unusual ? 'down' : 'muted'}">${g.unusual ? 'unusual' : 'normal'}</td></tr>`)
      .join('') + '</tbody>';
    $('ccy-table').innerHTML = m.currencies
      .map((c: any) => `<tr><th>${c.ccy}</th><td>${c.price.toLocaleString('en-US', { maximumFractionDigits: c.price > 1000 ? 0 : 2 })}</td><td class="${c.change_1y >= 0 ? 'up' : 'down'}">${pctf(c.change_1y)}</td></tr>`)
      .join('');
  }

  let debtTimer = 0;
  function drawDebt(d: any) {
    const m = d.markets;
    const base = Date.parse(m.us_debt.date + 'T23:59:59Z');
    cancelAnimationFrame(debtTimer);
    const tick = () => {
      const v = m.us_debt.total + m.us_debt.per_second * ((Date.now() - base) / 1000);
      $('counter').textContent = '$' + Math.round(v).toLocaleString('en-US');
      debtTimer = requestAnimationFrame(tick);
    };
    tick();
    $('counter-note').textContent = `Last official figure ${money(m.us_debt.total / 1e12, 2)} trillion on ${m.us_debt.date} (Treasury, Debt to the Penny); counting at the last 12 months' pace of ${money(m.us_debt.per_second, 0)} per second. ${m.us_debt.gdp_pct.toFixed(0)}% of GDP.`;
    const g = m.government_debt;
    $('gov-title').textContent = `Government debt, % of GDP, ${g.year} (IMF) vs 2007`;
    const max = Math.max(...g.countries.map((c: any) => Math.max(c.pct, c.in_2007 ?? 0)));
    $('gov-bars').innerHTML = g.countries
      .map((c: any) => `<div class="gbar"><span>${esc(c.country)}</span><div><i style="width:${(100 * c.pct) / max}%"></i>${c.in_2007 ? `<u style="left:${(100 * c.in_2007) / max}%" title="2007: ${c.in_2007}%"></u>` : ''}</div><b>${c.pct.toFixed(0)}%</b></div>`)
      .join('');
    const ext = m.external_debt;
    const emax = Math.max(...ext.map((c: any) => Math.max(c.pct, c.pct_2011 ?? 0)));  // scale covers the 2011 markers too (UK was 352% then)
    $('ext-bars').innerHTML = ext
      .map((c: any) => `<div class="gbar"><span>${esc(c.country)}</span><div><i style="width:${(100 * c.pct) / emax}%"></i>${c.pct_2011 ? `<u style="left:${(100 * c.pct_2011) / emax}%" title="2011: ${c.pct_2011}%"></u>` : ''}</div><b>${c.pct}%</b></div>`)
      .join('');
    const nh = m.niip_history;
    if (nh.length) {
      const svgN = $('niip');
      const W = Math.max(280, svgN.clientWidth), H = svgN.clientHeight || 220, L = 30, B = 22, T = 8;
      svgN.setAttribute('viewBox', `0 0 ${W} ${H}`);
      const vmax = Math.max(...nh.map((p: any) => p[1])) * 1.1, vmin = Math.min(0, ...nh.map((p: any) => p[1]));
      const t0 = Date.parse(nh[0][0] + '-01'), t1 = Date.parse(nh[nh.length - 1][0] + '-01');
      const x = (m: string) => L + ((W - L - 6) * (Date.parse(m + '-01') - t0)) / (t1 - t0);
      const y = (v: number) => T + (H - T - B) * (1 - (v - vmin) / (vmax - vmin));
      let g = '';
      for (let v = 0; v <= vmax; v += 20) g += `<line x1="${L}" x2="${W}" y1="${y(v)}" y2="${y(v)}" class="grid"/><text x="${L - 4}" y="${y(v) + 4}" class="axis" text-anchor="end">${v}</text>`;
      ['1980', '1990', '2000', '2010', '2020'].forEach((yr) => (g += `<text x="${x(yr + '-01')}" y="${H - 6}" class="axis" text-anchor="middle">${yr}</text>`));
      g += `<path d="M ${nh.map((p: any) => `${x(p[0]).toFixed(1)} ${y(p[1]).toFixed(1)}`).join(' L ')} L ${x(nh[nh.length - 1][0])} ${y(0)} L ${x(nh[0][0])} ${y(0)} Z" class="area"/>`;
      g += `<path d="M ${nh.map((p: any) => `${x(p[0]).toFixed(1)} ${y(p[1]).toFixed(1)}`).join(' L ')}" class="line"/>`;
      $('niip').innerHTML = g;
      const v11 = nh.find((p: any) => p[0] >= '2011-01')?.[1];
      $('niip-note').textContent = `What the US owes the rest of the world minus what it owns abroad: ${nh[nh.length - 1][1]}% of GDP (${nh[nh.length - 1][0]}), up from ${v11}% in 2011. In 1976 the US was a net creditor. Source: BEA via FRED.`;
    }
    $('cb-table').innerHTML = m.central_banks
      .slice()
      .sort((a: any, b: any) => b.tonnes - a.tonnes)
      .map((c: any) => `<tr><th>${esc(c.country)}</th><td>${c.tonnes.toLocaleString('en-US')} t</td><td class="${c.change_12m > 0 ? 'up' : c.change_12m < 0 ? 'down' : 'muted'}">${c.change_12m > 0 ? '+' : ''}${c.change_12m} t / 12 m</td></tr>`)
      .join('');
  }

  function drawTicker(d: any) {
    const m = d.markets, ch = m.change_24h || {};
    // label, value, its change over the last day: % for prices, points for rates and our readings
    const items: [string, string, string, string][] = [
      ['GOLD', money(m.gold.price), 'gold', '%'],
      ['SILVER', money(m.gold.silver), 'silver', '%'],
      ['GOLD/SILVER', num(m.gold.gold_silver, 1), 'gold_silver', '%'],
      ['BTC', money(m.btc.price, 0), 'btc', '%'],
      ['BTC IN GOLD', num(m.btc.in_gold_oz, 1) + ' oz', 'btc_gold', '%'],
      ['US 10Y', num(m.yields.us10) + '%', 'us10', 'pp'],
      ['US 2Y', num(m.yields.us2) + '%', 'us2', 'pp'],
      ['10Y REAL', num(m.yields.us10_real) + '%', 'us10_real', 'pp'],
      ['VIX', num(m.vix, 1), 'vix', '%'],
      ['US DEBT', money(m.us_debt.total / 1e12, 2) + 'T', 'us_debt', '%'],
      ['SCORE', d.score.toFixed(1), 'score', 'pts'],
      ['CRISIS NOW', d.acute.toFixed(0), 'acute', 'pts'],
      ['STRUCTURAL', d.structural.toFixed(0), 'structural', 'pts'],
      ['FED FUNDS', num(m.fed.rate) + '%', 'fed', 'pp'],
      ['RECESSION 12M', d.forecast.probability.toFixed(0) + '%', 'recession', 'pts'],
    ];
    const delta = (k: string, u: string) => {
      const v = ch[k];
      if (v == null) return '';  // not a day of history yet
      return ` <b class="${v > 0 ? 'up' : v < 0 ? 'down' : 'muted'}">${v > 0 ? '+' : ''}${v.toFixed(u === 'pts' ? 1 : 2)}${u === '%' ? '%' : ''}</b>`;
    };
    const html = items.map(([k, v, c, u]) => `<span><em>${k}</em> ${v}${delta(c, u)}</span>`).join('');
    $('ticker').innerHTML = html + html;
  }

  function drawTerminal(d: any) {
    const lines = d.sources.map((s: any) => {
      const ok = s.ok ? '<b class="ok">[ ok ]</b>' : '<b class="err">[fail]</b>';
      const when = s.fetched ? new Date(s.fetched * 1000).toISOString().slice(0, 16).replace('T', ' ') : '—';
      return `${ok} ${when}  ${esc(s.key.padEnd(16))} last ${esc((s.last ?? '—').slice(0, 10))}  ${esc(s.label)} <span class="muted">· ${esc(s.source)}</span>`;
    });
    $('terminal').innerHTML = `$ collect --all  # ${d.sources.filter((s: any) => s.ok).length}/${d.sources.length} feeds healthy, score computed ${d.updated}\n` + lines.join('\n');
  }

  function drawOdds(d: any) {
    const o = d.odds;
    // the cards and their labels are in the page; fill the numbers
    document.querySelectorAll<HTMLElement>('#odds-grid [data-k]').forEach((c) => {
      const x = o[c.dataset.k!];
      c.style.display = x.like == null ? 'none' : '';
      if (x.like == null) return;
      const diff = x.like - x.base;
      c.classList.remove('up-risk', 'down-risk', 'avg-risk');
      c.classList.add(diff >= 10 ? 'up-risk' : diff <= -10 ? 'down-risk' : 'avg-risk');
      c.querySelector('.ov')!.textContent = `${x.like}%`;
      c.querySelector('.ob span')!.textContent = `average month ${x.base}%`;
      c.querySelector('.ob i')!.textContent = `${diff > 0 ? '+' : ''}${diff} pts`;
    });
    $('odds-note').textContent = `Every month since 1973 with no crisis under way, weighted by how close its score was to today's ${d.score.toFixed(0)} (half weight 6 points away; about ${o.crisis_12m.months} months' worth), and what happened next, against the average month. History, not a forecast.`;
  }

  const LEAD_COLORS: Record<string, string> = { stress: '#e05a47', warning: '#8fb3ff', permits: '#d9b45a', lending: '#c89cf0', claims: '#6fbf8e', vix_rise: '#9c9584' };
  function drawLeads(d: any) {
    const L = d.leads;
    $('lead-n').textContent = String(L.events);
    const svg = $('leadchart');
    const Wd = Math.max(300, svg.clientWidth), Ht = svg.clientHeight || 280, l = 30, r = 8, t = 10, b = 24;
    svg.setAttribute('viewBox', `0 0 ${Wd} ${Ht}`);
    const n = L.lags.length;
    const x = (i: number) => l + ((Wd - l - r) * i) / (n - 1);
    const y = (v: number) => t + (Ht - t - b) * (1 - v / 100);
    let g = '';
    for (let v = 0; v <= 100; v += 25) g += `<line x1="${l}" x2="${Wd - r}" y1="${y(v)}" y2="${y(v)}" class="grid"/><text x="${l - 4}" y="${y(v) + 4}" class="axis" text-anchor="end">${v}</text>`;
    g += `<line x1="${l}" x2="${Wd - r}" y1="${y(50)}" y2="${y(50)}" class="mid"/>`;
    const i0 = L.lags.indexOf(0);
    g += `<line x1="${x(i0)}" x2="${x(i0)}" y1="${t}" y2="${Ht - b}" class="start"/><text x="${x(i0) + 4}" y="${t + 10}" class="axis">crisis starts</text>`;
    L.lags.forEach((lag: number, i: number) => { if (lag % 6 === 0) g += `<text x="${x(i)}" y="${Ht - 6}" class="axis" text-anchor="${i === 0 ? 'start' : i === n - 1 ? 'end' : 'middle'}">${lag > 0 ? '+' : ''}${lag}m</text>`; });
    Object.entries(L.study).forEach(([k, vals]: [string, any]) => {
      const pts = vals.map((v: number | null, i: number) => (v == null ? null : `${x(i).toFixed(1)},${y(v).toFixed(1)}`)).filter(Boolean);
      g += `<polyline points="${pts.join(' ')}" fill="none" stroke="${LEAD_COLORS[k]}" stroke-width="${k === 'stress' || k === 'warning' ? 2.4 : 1.6}" ${k === 'vix_rise' ? 'stroke-dasharray="4 4"' : ''}/>`;
    });
    svg.innerHTML = g;
    $('lead-legend').innerHTML = Object.keys(L.study).map((k) => `<span><span class="key" style="background:${LEAD_COLORS[k]}"></span> ${esc(L.labels[k])}</span>`).join('');
    $('lead-table').innerHTML = `<thead><tr><th></th><th>Today</th><th>6m before</th><th>AUC crisis · fall · recession</th></tr></thead><tbody>` +
      L.checklist.map((c: any) => `<tr><th>${esc(c.label)}</th><td class="${c.now >= c.before6 ? 'down' : 'up'}">${c.now}</td><td>${c.before6 ?? '—'}</td><td>${c.auc.crisis ?? '—'} · ${c.auc.bear ?? '—'} · ${c.auc.recession ?? '—'}</td></tr>`).join('') + '</tbody>';
  }

  function drawFlags(d: any) {
    const li = (f: any) => `<li><span>${esc(f.label)}</span><b>${esc(f.shown)}</b><em>${f.pct}</em></li>`;
    $('flags-high').innerHTML = d.flags.high.map(li).join('') || '<li class="muted">None</li>';
    $('flags-low').innerHTML = d.flags.low.map(li).join('') || '<li class="muted">None</li>';
    $('flag-count').textContent = `· ${d.flags.high.length}`;
    const o = d.markets.oil;
    if (o.pct >= 85) $('flags-high').innerHTML += `<li><span>Oil (WTI), 12-month change · watch item, not scored</span><b>${pctf(o.change_1y, 0)}</b><em>${o.pct}</em></li>`;
  }

  function drawOutlook(d: any) {
    const o = d.outlook;
    if (!o) return;  // its sources failed this run: the panel keeps its placeholders
    const sg = (v: number, dp = 1) => `${v > 0 ? '+' : ''}${v.toFixed(dp)}%`;
    $('ol-stocks').textContent = sg(o.expected);
    $('ol-stocks-note').textContent = `80% range ${sg(o.lo80)} to ${sg(o.hi80)}; the average decade since 1881 gave ${sg(o.average)}`;
    $('ol-bonds').textContent = sg(o.tips, 2);
    const sp = o.since_peak_rate;
    $('ol-bonds-note').textContent = sp
      ? `The 10-year yield is ${o.y10.toFixed(2)}%, up ${sp.y10_change.toFixed(2)} pp since ${monthName(sp.month)} although the Fed has cut ${(-sp.fed_change).toFixed(2)} pp: lenders want more to lend long`
      : `The ordinary 10-year yield is ${o.y10.toFixed(2)}%`;
    $('ol-neg').textContent = `${o.p_negative}%`;
    $('ol-neg-note').textContent = `${o.p_negative_all}% of all decades since 1881`;
    $('ol-tips').textContent = `${o.p_below_tips}%`;
    $('beyond-table').innerHTML = `<thead><tr><th></th><th>Now</th><th>Known high</th></tr></thead><tbody>` + o.beyond
      .map((b: any) => `<tr><th>${esc(b.label)}${b.note ? ` <span class="muted">· ${esc(b.note)}</span>` : ''}</th><td class="down">${b.now.toFixed(1)}%</td><td class="muted">${b.known_max.toFixed(1)}% · ${monthName(b.known_max_month)}</td></tr>`)
      .join('') + '</tbody>';
    const e = o.expensive;
    $('ol-how').textContent = `The estimate averages two straight-line fits on Robert Shiller's data since 1871, each made only from decades already over: one on CAPE (price against ten years of earnings, now ${o.cape.toFixed(1)}; the record is ${o.cape_max.toFixed(1)} in ${monthName(o.cape_max_month)}) and one on the excess CAPE yield, which compares earnings with what bonds pay. ` +
      (e ? `Every month with a CAPE this high (${monthName(e.first)} to ${monthName(e.last)}) was followed by a decade of ${sg(e.worst)} to ${sg(e.best)} a year, but that is one episode, the dot-com bust. ` : '') +
      `In January 2000 the model said ${sg(o.y2000.forecast)} a year; the decade delivered ${sg(o.y2000.actual)}. Over the last 20 years of known outcomes it was too gloomy by ${o.bias20.toFixed(1)} points a year (the decade from ${monthName(o.last_decade.start)} returned ${sg(o.last_decade.actual)} a year). Ten-year windows overlap, so 145 years hold only about 14 independent decades: read it as a range, not a forecast. Not financial advice.`;
  }

  const UNREST_NAMES: Record<string, string> = { USA: 'United States', GBR: 'United Kingdom', FRA: 'France', DEU: 'Germany', ITA: 'Italy', ESP: 'Spain', NLD: 'Netherlands', POL: 'Poland' };
  function drawSociety(d: any) {
    const s = d.society;
    if (!s) return;  // a v6 JSON (mid-deploy)
    const th = (n: number) => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] || 'th');
    const tile = (id: string, x: any, big: string, note: string) => {
      if (!x) return;
      $(id).textContent = big;
      $(id + '-note').textContent = note;
    };
    const rec = (x: any) => `${x.value.toFixed(0)} in ${monthName(x.date)}; the record, ${x.max.toFixed(0)}, was in ${monthName(x.max_month)}`;
    tile('so-us', s.epu_us, s.epu_us && th(s.epu_us.pct), s.epu_us && `${rec(s.epu_us)}. In the stress pillar.`);
    const ec = Object.entries(s.epu_countries || {}).filter(([, x]) => x).map(([c, x]: [string, any]) => `${{ DE: 'Germany', FR: 'France', GB: 'UK', IT: 'Italy', ES: 'Spain' }[c]} ${th(x.pct)}`);
    tile('so-eu', s.epu_eu, s.epu_eu && th(s.epu_eu.pct), s.epu_eu && `${rec(s.epu_eu)}. ${ec.join(', ')}. In the stress pillar.`);
    tile('so-gpr', s.gpr, s.gpr && th(s.gpr.pct), s.gpr && `${rec(s.gpr)}. In build-up, the other way round: calm years came before crises.`);
    const day = (x: string) => new Date(x + 'T00:00:00Z').toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
    const sign = (v: number, dp = 2) => (v > 0 ? '+' : v < 0 ? '−' : '') + Math.abs(v).toFixed(dp);
    tile('so-pci', s.partisan, s.partisan && th(s.partisan.pct), s.partisan && `${rec(s.partisan)}. Not in the score.`);
    const mg = Object.entries(s.migration || {}).filter(([, x]) => x) as [string, any][];
    const q = (x: any) => `Q${Math.ceil(+x.date.slice(5, 7) / 3)} ${x.date.slice(0, 4)}`;
    tile('so-mig', mg.length ? mg : null, th(Math.round(mg.reduce((a, [, x]) => a + x.pct, 0) / (mg.length || 1))),
      mg.length && `${mg.map(([c, x]) => `${{ US: 'US', GB: 'UK', DE: 'Germany' }[c]} ${th(x.pct)}`).join(', ')}, to ${q(mg[0][1])}. Not in the score.`);
    tile('so-tpu', s.trade, s.trade && th(s.trade.pct), s.trade && `${rec(s.trade)}. Not in the score.`);
    const n = s.news;
    tile('so-news', n, n && th(100 - n.pct), n && `${sign(n.value)} on ${day(n.date)} (below zero is negative); the low, ${sign(n.max)}, was in ${monthName(n.max_month)}. Not in the score: it flags crises as they happen, but markets get there first.`);
    const e = s.eu_conf;
    tile('so-euconf', e, e && th(100 - e.pct), e && `confidence ${sign(e.value, 1)} in ${monthName(e.date)}; the low, ${sign(e.max, 1)}, was in ${monthName(e.max_month)}. Not in the score.`);
    const u = s.unrest_world;
    tile('so-unrest', u, u && u.value.toFixed(0), u && `of about 130 the IMF tracks · ${th(u.pct)} percentile since ${u.since} · the record, ${u.max.toFixed(0)}, was ${monthName(u.max_month)} · to ${monthName(u.date)} · not in the score`);
    $('unrest-table').innerHTML = `<thead><tr><th></th><th>Percentile</th><th>Latest</th></tr></thead><tbody>` + Object.entries(s.unrest_countries || {})
      .filter(([, x]) => x).sort((a: any, b: any) => b[1].pct - a[1].pct)
      .map(([c, x]: [string, any]) => `<tr><th>${esc(UNREST_NAMES[c] || c)}</th><td class="${x.pct >= 85 ? 'down' : ''}">${th(x.pct)}</td><td class="muted">${monthName(x.date)}</td></tr>`)
      .join('') + '</tbody>';
  }

  const HH: [string, string, (v: number) => string][] = [  // key, label, format
    ['years_pay', 'Years of a typical worker’s pay to buy the median new home', (v) => v.toFixed(1)],
    ['price_income', 'House price-to-income ratio (median new home ÷ median family income)', (v) => v.toFixed(1) + '×'],
    ['mortgage_share', 'Mortgage payment, share of a typical worker’s pay', (v) => (100 * v).toFixed(0) + '%'],
    ['price_rent', 'Price-to-rent ratio (house prices ÷ rents, first year = 100)', (v) => v.toFixed(0)],
    ['misery', 'Misery index (unemployment + inflation)', (v) => v.toFixed(1)],
    ['sentiment', 'Consumer sentiment (University of Michigan)', (v) => v.toFixed(1)],
    ['saving', 'Personal saving rate', (v) => v.toFixed(1) + '%'],
    ['debt_service', 'Household debt payments, share of income', (v) => v.toFixed(1) + '%'],
    ['labour_share', 'Labour share of income (2017 = 100)', (v) => v.toFixed(1)],
    ['pay_gap', 'Productivity-pay gap (output per hour ÷ typical pay, 1948 = 1)', (v) => v.toFixed(2) + '×'],
    ['ceo_ratio', 'CEO-to-worker pay ratio', (v) => v.toFixed(0) + '×'],
    ['gini', 'Gini index of family income (0 = equal)', (v) => v.toFixed(3)],
    ['wealth_top1', 'Top 1%’s share of household wealth', (v) => v.toFixed(1) + '%'],
    ['wealth_bottom50', 'Bottom half’s share of household wealth', (v) => v.toFixed(1) + '%'],
  ];
  function drawHouseholds(d: any) {
    const h = d.households;
    if (!h) return;  // a JSON from before the panel (mid-deploy)
    // annual values are dated by year, quarterly ones by the quarter's first month
    const when = (k: string, m: string) => m.length === 4 ? m : ['misery', 'sentiment', 'saving', 'strain'].includes(k) ? monthName(m) : `Q${Math.ceil(+m.slice(5, 7) / 3)} ${m.slice(0, 4)}`;
    const th = (n: number) => n + (n % 100 >= 11 && n % 100 <= 13 ? 'th' : ['th', 'st', 'nd', 'rd'][n % 10] || 'th');
    const s = h.strain, y = h.years_pay, c = h.ceo_ratio, g = h.pay_gap;
    if (s) {
      $('hh-strain').textContent = s.now.toFixed(0);
      const top = Object.entries(s.themes).sort((a: any, b: any) => b[1] - a[1]).map(([t, v]) => `${t} ${v}`).join(', ');
      $('hh-strain-note').textContent = `higher than in ${s.bad}% of months since ${s.since} · ${s.then.toFixed(0)} in ${s.then_year} · the worst, ${s.worst.toFixed(0)}, was ${monthName(s.worst_date)} · today by theme: ${top}`;
    }
    if (y) { $('hh-years').textContent = y.now.toFixed(1); $('hh-years-note').textContent = `${y.then.toFixed(1)} in ${y.then_year} · the worst, ${y.worst.toFixed(1)}, was ${when('years_pay', y.worst_date)} · now ${when('years_pay', y.date)}`; }
    if (c) { $('hh-ceo').textContent = c.now.toFixed(0) + '×'; $('hh-ceo-note').textContent = `${c.then.toFixed(0)}× in ${c.then_year} · the peak, ${c.worst.toFixed(0)}×, was in ${c.worst_date} · realized pay, ${c.date}`; }
    if (g && g.productivity != null) {
      $('hh-gap').textContent = `+${(100 * g.productivity).toFixed(0)}% / +${(100 * g.pay).toFixed(0)}%`;
      $('hh-gap-note').textContent = `output per hour vs a typical worker's pay, ${g.then_year} to ${when('pay_gap', g.date)} (Economic Policy Institute's productivity-pay gap) · labour's share of income is ${h.labour_share && h.labour_share.bad >= 99 ? 'at its lowest since ' + h.labour_share.since : th(h.labour_share?.bad ?? 0) + ' percentile of lowness'}`;
    }
    $('hh-table').innerHTML = `<thead><tr><th></th><th>1970</th><th>Now</th><th>Worst</th></tr></thead><tbody>` + HH.filter(([k]) => h[k]).map(([k, label, f]) => {
      const x = h[k];
      return `<tr><th>${esc(label)}</th><td>${f(x.then)}${x.then_year !== '1970' ? ` <span class="muted">${x.then_year}</span>` : ''}</td>` +
        `<td class="${x.bad >= 85 ? 'down' : ''}" title="${esc(when(k, x.date))}">${f(x.now)}</td><td>${f(x.worst)} <span class="muted">${esc(when(k, x.worst_date))}</span></td></tr>`;
    }).join('') + '</tbody>';
    if (!s) return;
    $('hh-since').textContent = s.since;
    const svg = $('hh-chart');
    const Wd = Math.max(280, svg.clientWidth), Ht = svg.clientHeight || 180, l = 26, r = 6, t = 8, b = 20;
    svg.setAttribute('viewBox', `0 0 ${Wd} ${Ht}`);
    const H = s.history, n = H.length;
    const x = (i: number) => l + ((Wd - l - r) * i) / (n - 1), yv = (v: number) => t + (Ht - t - b) * (1 - v / 100);
    let svgs = '';
    for (let v = 0; v <= 100; v += 25) svgs += `<line x1="${l}" x2="${Wd - r}" y1="${yv(v)}" y2="${yv(v)}" class="grid"/><text x="${l - 4}" y="${yv(v) + 4}" class="axis" text-anchor="end">${v}</text>`;
    H.forEach(([yr]: [string], i: number) => { if (+yr % 10 === 0) svgs += `<text x="${x(i)}" y="${Ht - 4}" class="axis" text-anchor="middle">${yr}</text>`; });
    svgs += `<polyline points="${H.map(([, v]: [string, number], i: number) => `${x(i).toFixed(1)},${yv(v).toFixed(1)}`).join(' ')}" class="line"/>`;
    svg.innerHTML = svgs;
  }

  function drawInflation(d: any) {
    const c = Object.fromEntries(d.components.map((x: any) => [x.key, x]));
    $('stag-now').textContent = d.stagflation.toFixed(0);
    const sd = d.stagflation_detail;
    $('stag-table').innerHTML =
      `<thead><tr><th>Index at least</th><th>In stagflation or within a year of it</th><th>Months</th></tr></thead><tbody>` +
      sd.thresholds.map((t: any) => `<tr><th>${t.at}</th><td>${t.near ?? '—'}%</td><td>${t.months}</td></tr>`).join('') +
      `<tr><th>Now</th><td colspan="2" class="muted">inflation ${sd.inflation.toFixed(1)}%, unemployment ${sd.unemployment_rise >= 0 ? '+' : ''}${sd.unemployment_rise.toFixed(1)} pp vs its 12-month low</td></tr></tbody>`;
    const rows = ['cpi', 'core_cpi', 'pce', 'sticky', 'median', 'trim_cpi', 'trim_pce', 'mct', 'ppi', 'exp5y5y', 'exp10', 'm2'].filter((k) => c[k]);
    const o = d.markets.oil, hp = d.markets.house_prices;
    $('infl-table').innerHTML = rows.map((k) => `<tr><th>${esc(c[k].label)}</th><td>${esc(c[k].shown)}</td><td class="muted">pct ${c[k].pct}</td></tr>`).join('') +
      `<tr><th>Oil (WTI), 12-month change</th><td>${pctf(o.change_1y, 0)}</td><td class="muted">pct ${o.pct} · $${o.price.toFixed(0)}</td></tr>` +
      `<tr><th>House prices (FHFA), 12 months</th><td>${pctf(hp.change_1y)}</td><td class="muted">${esc(hp.date.slice(0, 7))}</td></tr>`;
    const f = d.markets.fed;
    $('fed-table').innerHTML = `<tr><th>Fed funds rate</th><td>${f.rate.toFixed(2)}%</td><td class="muted">a year ago ${f.rate_1y_ago.toFixed(2)}%</td></tr>
      <tr><th>Real policy rate (minus CPI inflation)</th><td>${f.real_rate >= 0 ? '+' : ''}${f.real_rate.toFixed(2)} pp</td><td class="muted">${f.real_rate > 1 ? 'restrictive' : f.real_rate < 0 ? 'loose' : 'roughly neutral'}</td></tr>
      <tr><th>Balance sheet</th><td>${money(f.balance_sheet / 1e6, 2)}T</td><td class="muted">${pctf(f.balance_sheet_change_1y)} in a year</td></tr>`;
    $('hyper').innerHTML = d.hyperinflation
      .map((h: any) => `<li class="${h.met ? 'met' : ''}"><b>${h.met ? '■' : '□'}</b><span>${esc(h.label)}</span><em>${h.threshold == null ? esc(h.note) : `now ${h.value.toFixed(1)}% · line ${h.threshold}%`}</em></li>`)
      .join('');
  }

  function render(d: any) {
    const answer = $('answer');
    answer.textContent = d.band.answer + (d.band.answer.endsWith('.') ? '' : '.');
    answer.dataset.band = d.band.key;
    answer.style.setProperty('--len', String(answer.textContent.length));  // "WOBBLING." must fit a phone as well as "NO."
    $('n-series').textContent = String(d.sources.length);
    document.documentElement.style.setProperty('--band', BAND_COLORS[d.band.key]);
    $('score').textContent = d.score.toFixed(1);
    $('band-label').textContent = d.band.label;
    $('pill-text').textContent = `${d.score.toFixed(0)} · ${d.band.label}`;
    $('updated').textContent = 'updated ' + ago(d.updated);
    const sr = d.structural_rank;
    if (d.summary) $('summary').textContent = d.summary; // written by collect.py, which also bakes it into the page
    const ro = (id: string, v: number) => { $(id).textContent = v.toFixed(0); $(id).style.color = BAND_COLORS[bandOf(v, d.bands).key]; };
    $('flag-strip').innerHTML = d.flags.high.slice(0, 5).map((f: any) => `<a class="fchip" href="#flags-s"><i></i>${esc(f.label)} <b>${esc(f.shown)}</b></a>`).join('') +
      (d.flags.high.length > 5 ? `<a class="fchip more" href="#flags-s">+${d.flags.high.length - 5} more</a>` : '');
    const KIND: Record<string, string> = { record: 'Record', move: 'Sudden move', gap: 'Markets apart' };
    $('unusual-list').innerHTML = (d.unusual || []).map((u: any) => `<li><i>${KIND[u.kind]}</i><span>${esc(u.label)} <b>${esc(u.shown)}</b></span><em>${esc(u.note)}</em></li>`).join('') ||
      '<li class="none">Nothing out of the ordinary: no records, sudden moves or markets pulling apart.</li>';  // collect.py bakes the same markup
    ro('ro-acute', d.acute);
    ro('ro-structural', d.structural);
    ro('ro-stag', d.stagflation);
    $('ro-rec').textContent = `${d.forecast.probability.toFixed(0)}%`;
    $('ro-record').textContent = `record ${sr.max.toFixed(0)}, ${monthName(sr.max_month)}`;
    const t = d.backtest.targets;
    $('good-at').textContent = `Telling calm from crisis. During US recessions the score ran higher than in normal months (AUC ${t.recession.score.during}); a year before them it was already elevated (AUC ${t.recession.score.ahead}), and the recession model alone scored ${d.forecast.track.auc} out of sample. The stagflation index flagged stagflation a year ahead with an AUC of ${t.stagflation.stagflation.ahead}. Of all months scoring 70 or more since 1973, ${d.backtest.thresholds.find((x: any) => x.at === 70)?.near}% were inside a crisis or within a year of one.`;
    drawGauge(d);
    drawPillars(d);
    drawBands(d);
    chartData = d;
    drawHistory();
    drawScorecard(d);
    drawCases(d);
    drawForecast(d);
    drawFlags(d);
    drawOdds(d);
    drawLeads(d);
    drawInflation(d);
    drawOutlook(d);
    drawSociety(d);
    drawHouseholds(d);
    drawVenues(d);
    drawDebt(d);
    drawTicker(d);
    drawTerminal(d);
  }

  let last = '';
  async function load() {
    try {
      const r = await fetch('/live/collapse.json', { cache: 'no-cache' });
      if (!r.ok) throw new Error(String(r.status));
      const d = await r.json();
      if (d.updated !== last) {
        last = d.updated;
        render(d);
      } else {
        $('updated').textContent = 'updated ' + ago(d.updated);
      }
      // the cron job refreshes every 15 minutes; say so if the data has gone stale
      const stale = Date.now() - Date.parse(d.updated) > 2 * 3600 * 1000;
      $('updated').classList.toggle('stale', stale);
      if (stale) $('updated').textContent = `data delayed · last update ${ago(d.updated)}`;
    } catch (e) {
      if (!last) {
        $('answer').textContent = 'CONN_ERR';
        $('answer').dataset.band = 'error';
        $('updated').textContent = 'data feed unavailable, retrying';
      }
    }
  }
  hookChart();
  // the view: simple (the default) or full; the inline script in <head> sets it before the first paint
  function setView(v: string) {
    document.documentElement.dataset.view = v;
    document.querySelectorAll<HTMLButtonElement>('.view button').forEach((b) => b.setAttribute('aria-pressed', String(b.value === v)));
    dispatchEvent(new Event('resize'));  // charts drawn while hidden had no width
  }
  document.querySelectorAll<HTMLButtonElement>('.set-view').forEach((b) =>
    b.addEventListener('click', () => {
      setView(b.value);
      try { localStorage.setItem('view', b.value); } catch {}
      scrollTo(0, 0);
    }),
  );
  addEventListener('hashchange', () => {  // header, footer and flag links point into the full monitor
    if (document.documentElement.dataset.view === 'full') return;
    setView('full');
    document.getElementById(location.hash.slice(1))?.scrollIntoView();
  });
  setView(document.documentElement.dataset.view!);
  // highlight the section in view in the sticky section bar
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.subnav a')];
  const spy = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      if (!e.isIntersecting) return;
      links.forEach((a) => a.classList.toggle('on', a.hash === '#' + e.target.id));
      const on = links.find((a) => a.classList.contains('on'));
      const bar = on?.parentElement;
      if (on && bar) bar.scrollTo({ left: on.offsetLeft - bar.clientWidth / 2 + on.clientWidth / 2, behavior: 'smooth' });
    }),
    { rootMargin: '-45% 0px -50% 0px' },
  );
  document.querySelectorAll('main section[id]').forEach((sec) => spy.observe(sec));
  load();
  setInterval(() => document.visibilityState === 'visible' && load(), 60_000);
</script>

